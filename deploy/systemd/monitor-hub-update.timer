# Runs the hub update once an hour. Persistent catches up on a run missed while the host was
# down; the randomized delay spreads it over ten minutes (docs/specs/deployment.md).

[Unit]
Description=Monitor hub update, hourly

[Timer]
OnCalendar=hourly
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
