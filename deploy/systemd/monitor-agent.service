# The agent, as a system service. Every path is fixed by docs/specs/deployment.md, so this
# file is the same on every node: what varies is in the environment file.

[Unit]
Description=Monitor agent
After=network-online.target
Wants=network-online.target
# A node whose environment file has no token makes the agent exit at once, and the restart
# loop is what keeps saying so. The default rate limit would silence it after five tries.
StartLimitIntervalSec=0

[Service]
Type=simple
# The agent reads the file itself, as data. Nothing of it reaches this command line, so no
# deployment setting is visible in `ps` to every local user.
ExecStart=/usr/local/bin/monitor-agent --env-file /etc/monitor/agent.env
Restart=always
RestartSec=5s

# The agent only reads: it stats mounted volumes, reads /proc and asks systemctl show, and
# posts what it found. Root is what makes every volume visible, and nothing beyond that is
# needed.
# No PrivateTmp: it would mount a private tmpfs over /tmp and /var/tmp inside the service's
# namespace, and the disk sensor enumerates volumes from /proc/self/mounts — a node whose
# /tmp is a real volume would simply stop reporting it, with no error and no silent-node
# event. The two directives below change what is writable, not what is mounted.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
