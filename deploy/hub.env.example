# Example hub environment file — synthetic values only (ADR 0007).
#
# The real file is /etc/monitor/hub.env, mode 0600 and owned by the monitor account. It is
# never committed: it holds every secret the hub needs. Its product configuration lives in
# hub.yaml instead.

# The address the hub serves on, host:port. Leave it out unless the host's default port is
# taken, and keep it a loopback address — the reverse proxy is what faces the network.
# MONITOR_LISTEN=

# One variable per node, named by that node's token_env — see config.example.yaml.
MONITOR_TOKEN_LAPTOP_A=replace-me
MONITOR_TOKEN_SERVER_B=replace-me

# Only when the notification channel is telegram.
MONITOR_TELEGRAM_TOKEN=replace-me
MONITOR_TELEGRAM_CHAT_ID=replace-me
